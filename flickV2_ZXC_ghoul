local function saveConfig()
    if not writefile then return false end
    if makefolder and not isfolder(FOLDER) then pcall(function() makefolder(FOLDER) end) end
    local ok, json = pcall(function() return HttpService:JSONEncode(Config) end)
    if not ok or not json then return false end
    return pcall(function() writefile(CONFIG_FILE, json) end)
end

local function loadConfig()
    local data
    if readfile and isfile and isfile(CONFIG_FILE) then
        local ok, d = pcall(function() return HttpService:JSONDecode(readfile(CONFIG_FILE)) end)
        if ok and type(d) == "table" then data = d end
    end
    -- Миграция старого конфига
    if not data and readfile and isfile and isfile("flick_mm2_config.json") then
        local ok, d = pcall(function() return HttpService:JSONDecode(readfile("flick_mm2_config.json")) end)
        if ok and type(d) == "table" then data = d end
    end
    if data then
        for k, v in pairs(data) do
            if Config[k] ~= nil then Config[k] = v end
        end
    end
    saveConfig()
end
