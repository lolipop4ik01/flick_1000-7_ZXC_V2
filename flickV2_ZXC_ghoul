            frame:TweenPosition(UDim2.new(0.5, -160, 0.75, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
            task.wait(duration)
            frame:TweenPosition(UDim2.new(0.5, -160, 0.85, 0), Enum.EasingDirection.In, Enum.EasingStyle.Quad, 0.3, true)
