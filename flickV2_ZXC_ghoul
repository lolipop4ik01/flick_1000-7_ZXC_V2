        fill.Size = UDim2.fromScale(0, 1)
        fill.BackgroundColor3 = C.accent
        fill.BorderSizePixel = 0
        fill.ZIndex = 6
        fill.Parent = bar
        addCorner(fill, UDim.new(1, 0))

        local knob = Instance.new("Frame")
        knob.Size = UDim2.fromOffset(12, 12)
        knob.AnchorPoint = Vector2.new(0.5, 0.5)
        knob.Position = UDim2.fromScale(0, 0.5)
        knob.BackgroundColor3 = C.text
        knob.BorderSizePixel = 0
        knob.ZIndex = 7
        knob.Parent = bar
        addCorner(knob, UDim.new(1, 0))
        addStroke(knob)

        local hit = Instance.new("TextButton")
        hit.Size = UDim2.new(1, 0, 0, 24)
        hit.Position = UDim2.new(0, 0, 0, 26)
        hit.BackgroundTransparency = 1
        hit.Text = ""
        hit.ZIndex = 8
        hit.Parent = row

        local function setValue(v, animate)
            v = math.clamp(math.floor(v * mult + 0.5) / mult, min, max)
            Config[key] = v
            local a = (v - min) / (max - min)
            valLbl.Text = tostring(v)
            if animate then
                tween(fill, {Size = UDim2.fromScale(a, 1)})
                tween(knob, {Position = UDim2.fromScale(a, 0.5)})
            else
                fill.Size = UDim2.fromScale(a, 1)
                knob.Position = UDim2.fromScale(a, 0.5)
            end
        end
        setValue(Config[key], false)

        local dragging = false
        local function fromInput(input)
            local a = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            setValue(min + (max - min) * a, true)
        end
        hit.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                tween(knob, {Size = UDim2.fromOffset(15, 15)})
                fromInput(input)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                fromInput(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
