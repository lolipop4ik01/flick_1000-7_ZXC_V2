    if getgenv().FlickKeybindConn then
        pcall(function() getgenv().FlickKeybindConn:Disconnect() end)
        getgenv().FlickKeybindConn = nil
    end
    pcall(function() if MainGui then MainGui:Destroy() end end)
    pcall(function()
        local notif = getSafeParent():FindFirstChild("Flick_Notify")
        if notif then notif:Destroy() end
    end)
    MainGui, MainFrame, CircleButton, bindBtnRef = nil, nil, nil, nil
    getgenv().FlickCleanup = nil
    getgenv().FlickLoaded = nil
    getgenv().Flick = nil
    print("[CORE] Fully unloaded.")
end
