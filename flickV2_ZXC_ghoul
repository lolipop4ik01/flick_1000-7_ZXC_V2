local function findShootRemote(verbose)
    local function log(msg) if verbose then print("[CORE] " .. msg) end end
    local char = LocalPlayer.Character
    if char then
        local gun = char:FindFirstChild("Gun")
        if gun then
            log("Gun in character")
            local shoot = gun:FindFirstChild("Shoot")
            if shoot and shoot:IsA("RemoteEvent") then return shoot end
            for _, v in ipairs(gun:GetDescendants()) do
                if v:IsA("RemoteEvent") then log("Fallback: " .. v:GetFullName()) return v end
            end
        end
    end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        local gun = bp:FindFirstChild("Gun")
        if gun then
            local shoot = gun:FindFirstChild("Shoot")
            if shoot and shoot:IsA("RemoteEvent") then return shoot end
            for _, v in ipairs(gun:GetDescendants()) do
                if v:IsA("RemoteEvent") then return v end
            end
        end
    end
    return nil
end

local function forceEquipGun()
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    if char:FindFirstChild("Gun") then return true end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if not bp then return false end
    local gun = bp:FindFirstChild("Gun")
    if not gun then return false end
    pcall(function() hum:EquipTool(gun) end)
    local deadline = tick() + Config.EquipTimeout
    while tick() < deadline do
        if char:FindFirstChild("Gun") then return true end
        RunService.Heartbeat:Wait()
    end
    return char:FindFirstChild("Gun") ~= nil
end

local function getMuzzlePosition(aimTarget)
    local char = LocalPlayer.Character
    if not char then return nil, "no character" end
    local gun = char:FindFirstChild("Gun")
    if not gun then return nil, "gun not equipped" end
    if not Config.ForceHandleOffset then
        for _, obj in ipairs(gun:GetDescendants()) do
            if obj:IsA("Attachment") and obj.Name:lower():find("raycast") then
                return obj.WorldPosition, "RaycastAttachment: " .. obj.Name
            end
        end
    end
    local handle = gun:FindFirstChild("Handle")
    if handle and handle:IsA("BasePart") then
        local fwd = Config.MuzzleForward or 2.5
        local up = Config.MuzzleUp or 0.5
        local muzzlePos = handle.Position + handle.CFrame.LookVector * fwd + Vector3.new(0, up, 0)
        return muzzlePos, string.format("Handle + Fwd:%.1f Up:%.1f", fwd, up)
    end
    return nil, "no handle"
end

-- ========== SENSITIVITY ==========
local sensitivityPxPerRad = 400
local sensitivityMeasured = false

local function calibrateSensitivity()
    if sensitivityMeasured then return end
    if Config.SensitivityPxPerRad and Config.SensitivityPxPerRad > 0 then
        sensitivityPxPerRad = Config.SensitivityPxPerRad
        sensitivityMeasured = true
        print(string.format("[CORE] Sensitivity from config: %.0f px/rad", sensitivityPxPerRad))
        return
    end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local ok = pcall(function()
        local oldBehavior = UserInputService.MouseBehavior
        if oldBehavior ~= Enum.MouseBehavior.LockCenter then
            pcall(function() UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter end)
            RunService.RenderStepped:Wait()
        end
        RunService.RenderStepped:Wait()
        local beforeCF = cam.CFrame
        local testPx = 10
        mousemoverel(testPx, 0)
        RunService.RenderStepped:Wait()
        RunService.RenderStepped:Wait()
        local afterCF = cam.CFrame
        mousemoverel(-testPx, 0)
        RunService.RenderStepped:Wait()
        RunService.RenderStepped:Wait()
        if oldBehavior ~= Enum.MouseBehavior.LockCenter then
            pcall(function() UserInputService.MouseBehavior = oldBehavior end)
        end
        local dot = math.clamp(beforeCF.LookVector:Dot(afterCF.LookVector), -1, 1)
        local angle = math.acos(dot)
        if angle > 1e-4 then
            sensitivityPxPerRad = testPx / angle
            sensitivityMeasured = true
            Config.SensitivityPxPerRad = sensitivityPxPerRad
            saveConfig()
            print(string.format("[CORE] Sensitivity measured: %.0f px/rad", sensitivityPxPerRad))
        else
            local mds = UserInputService.MouseDeltaSensitivity
            if mds and mds > 0 then sensitivityPxPerRad = 400 / mds end
            sensitivityMeasured = true
            Config.SensitivityPxPerRad = sensitivityPxPerRad
            saveConfig()
            print(string.format("[CORE] Sensitivity fallback: %.0f px/rad", sensitivityPxPerRad))
        end
    end)
    if not ok then
        sensitivityPxPerRad = 400
        sensitivityMeasured = true
    end
end

function findMurderer()
    local byRole, byKnife = nil, nil
    if game.PlaceId == 142823291 then
        local ok, roleData = pcall(function()
            local remote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
            if remote and remote:IsA("RemoteFunction") then return remote:InvokeServer() end
        end)
        if ok and type(roleData) == "table" then
            for playerName, data in pairs(roleData) do
                if type(data) == "table" and (data.Role == "Murderer" or data.RoleId == 1) and not data.Killed and not data.Dead then
                    local p = Players:FindFirstChild(playerName)
                    if p and p.Character then byRole = p break end
                end
            end
        end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local bp = player:FindFirstChild("Backpack")
                if (bp and bp:FindFirstChild("Knife")) or char:FindFirstChild("Knife") then
                    byKnife = player break
                end
            end
        end
    end
    return byRole or byKnife
end

