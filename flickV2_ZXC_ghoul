            if input.KeyCode ~= Enum.KeyCode.Unknown then
                Config.Keybind = input.KeyCode.Name
                saveConfig()
                if bindBtnRef then bindBtnRef.Text = "⌨️ BIND: " .. Config.Keybind end
            end
            return
        end
        if input.KeyCode == Enum.KeyCode[Config.Keybind] then task.spawn(flickToMurderer) end
    end)
end

