local function getPing()
    local ok, p = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    return ok and (p / 1000) or 0
end

local velocityCache = {}
local function getSmoothedVelocity(part)
    if not Config.VelocitySmooth then return part.AssemblyLinearVelocity end
    local now = tick()
    local key = tostring(part)
    if not velocityCache[key] then velocityCache[key] = {} end
    local cache = velocityCache[key]
    table.insert(cache, {v = part.AssemblyLinearVelocity, t = now})
    while #cache > 0 and now - cache[1].t > 0.1 do table.remove(cache, 1) end
    local avg = Vector3.zero
    for _, e in ipairs(cache) do avg = avg + e.v end
    if #cache > 0 then avg = avg / #cache end
    return avg
end

local function getPredictedPosition(part)
    if not part or not Config.PredictEnabled then return part.Position end
    local vel = getSmoothedVelocity(part)
    if not vel then return part.Position end
    local mxz, my = Config.PredictXZ, part.Name == "HumanoidRootPart" and 0 or Config.PredictY
    if Config.PredictOp == "Divide" then
        if mxz > 0 then mxz = 1 / mxz else mxz = 0 end
        if my > 0 then my = 1 / my else my = 0 end
    end
    local offset = Vector3.new(vel.X * mxz, vel.Y * my, vel.Z * mxz)
    if Config.PingComp then
        local po = vel * (getPing() * 0.5)
        if part.Name == "HumanoidRootPart" then po = Vector3.new(po.X, 0, po.Z) end
        offset = offset + po
    end
    return part.Position + offset
end

local function getAngularDelta(cam, targetPos)
    local camPos = cam.CFrame.Position
    local delta = targetPos - camPos
    if delta.Magnitude < 0.1 then return 0, 0 end
    local localDir = cam.CFrame:VectorToObjectSpace(delta.Unit)
    local yaw = math.atan2(localDir.X, -localDir.Z)
    local pitch = math.atan2(localDir.Y, math.sqrt(localDir.X * localDir.X + localDir.Z * localDir.Z))
    return yaw, pitch
end

local function adjustTargetForEnvironment(shootOrigin, targetPos, murdererChar)
    if not Config.EnvCheck then return targetPos, false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local filter = {}
    if LocalPlayer.Character then table.insert(filter, LocalPlayer.Character) end
    if murdererChar then table.insert(filter, murdererChar) end
    params.FilterDescendantsInstances = filter
    local result = targetPos
    local adjusted = false
    if Config.LastVisible then
        local dir = targetPos - shootOrigin
        if dir.Magnitude > 0.5 then
            local ray = workspace:Raycast(shootOrigin, dir, params)
            if ray then
                result = shootOrigin + dir.Unit * math.max(0.5, ray.Distance - Config.WallOffset)
                adjusted = true
            end
        end
    end
    if Config.RaiseOnFall then
        local downRay = workspace:Raycast(result, Vector3.new(0, -Config.RayCheckRange, 0), params)
        if downRay and downRay.Distance < 2.5 then
            result = result + Vector3.new(0, math.max(Config.FallRaise, 2.5 - downRay.Distance), 0)
            adjusted = true
        end
    end
    return result, adjusted
end

local function applySelfVelocityComp(pos)
    if not Config.SelfVelocityComp then return pos end
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return pos end
    local myVel = myHrp.AssemblyLinearVelocity
    if myVel.Magnitude < 0.1 then return pos end
    return pos + myVel * (getPing() * 0.5)
end

local function smoothReturn(accumX, accumY)
    if not Config.ReturnCamera then return end
    if accumX == 0 and accumY == 0 then return end

    local baseDelay = Config.ReturnDelay + math.random(0, Config.ReturnRandomDelayMs)
    if baseDelay > 0 then task.wait(baseDelay / 1000) end

    -- направление и дистанция фиксированы ОДИН раз
    local randX = math.random(-Config.ReturnRandomPxX, Config.ReturnRandomPxX)
    local randY = math.random(-Config.ReturnRandomPxY, Config.ReturnRandomPxY)
    local targetX = -accumX + randX
    local targetY = -accumY + randY
    local dist = math.sqrt(targetX * targetX + targetY * targetY)
    if dist < 1 then return end

    -- N кадров на весь возврат: ReturnSpeed 25 -> 16 кадров, 40 -> 10, 120 -> 3
    local N = math.clamp(math.floor(400 / math.max(Config.ReturnSpeed, 3)), 3, 120)
    local stepX0 = targetX / N
    local stepY0 = targetY / N

    local jitter = math.clamp(Config.ReturnJitter or 0.15, 0, 1)
    local jitterPx = jitter * 0.8  -- ±0.8px шума на кадр при максимуме

    local cx, cy = 0, 0
    for i = 1, N do
        if not getgenv().FlickRunning then break end

        local stepX, stepY
        if i == N then
            -- последний кадр — точное закрытие, без накопленного шума
            stepX = targetX - cx
            stepY = targetY - cy
        else
            stepX = stepX0
            stepY = stepY0
            if jitterPx > 0.01 then
                stepX = stepX + (math.random() * 2 - 1) * jitterPx
                stepY = stepY + (math.random() * 2 - 1) * jitterPx
            end
        end

        mousemoverel(stepX, stepY)
        cx = cx + stepX
        cy = cy + stepY
        RunService.RenderStepped:Wait()
    end
end

local isFlicking = false

local function aimLoop(getTargetPos)
    local cam = workspace.CurrentCamera
    local pxPerRad = (sensitivityPxPerRad > 0) and sensitivityPxPerRad or 400
    local accumX, accumY = 0, 0
    local tolerance = math.rad(Config.AimToleranceDeg)

    local lockedTarget = getTargetPos()
    if not lockedTarget then return accumX, accumY, nil, false end

    local yaw0, pitch0 = getAngularDelta(cam, lockedTarget)
    local initialAngle = math.sqrt(yaw0 * yaw0 + pitch0 * pitch0)
    if initialAngle < tolerance then return accumX, accumY, lockedTarget, true end

    -- N кадров на весь флик. AimSpeed 1.0 -> 8 кадров, 0.6 -> 13, 0.3 -> 26
    local N = math.clamp(math.floor(8 / math.max(Config.AimSpeed, 0.05)), 3, 120)
    local perFrameAngle = initialAngle / N

    for i = 1, N + 4 do
        if not getgenv().FlickRunning then break end

        local fresh = getTargetPos()
        if fresh then lockedTarget = fresh end

        local yaw, pitch = getAngularDelta(cam, lockedTarget)
        local angle = math.sqrt(yaw * yaw + pitch * pitch)
        if angle < tolerance then
            return accumX, accumY, lockedTarget, true
        end

        -- шаг: ровно perFrameAngle, но не больше остатка
        local stepAngle = math.min(perFrameAngle, angle)
        local scale = stepAngle / angle

        local dx = yaw * pxPerRad * scale
        local dy = -pitch * pxPerRad * scale
        local mag = math.sqrt(dx * dx + dy * dy)
        if mag > Config.AimMaxPixels then
            local k = Config.AimMaxPixels / mag
            dx, dy = dx * k, dy * k
        end
        mousemoverel(dx, dy)
        accumX = accumX + dx
        accumY = accumY + dy
        RunService.RenderStepped:Wait()
    end

    return accumX, accumY, lockedTarget, true
end

local function scheduleUnequip()
    if not Config.UnequipAfterShot then return end
    task.spawn(function()
        local lo = math.min(Config.UnequipDelayMin, Config.UnequipDelayMax)
        local hi = math.max(Config.UnequipDelayMin, Config.UnequipDelayMax)
        local delay = math.random(lo, hi) / 1000
        task.wait(delay)
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        pcall(function() hum:UnequipTools() end)
    end)
end

function flickToMurderer()
    if not Config.Enabled or isFlicking then return end
    isFlicking = true
    local murderer = cachedMurderer or findMurderer()
    if not murderer then isFlicking = false return end
    local cam = workspace.CurrentCamera
    local char = LocalPlayer.Character
    if not char then isFlicking = false return end
    local hasGun = forceEquipGun()
    if hasGun then task.wait(0.05) end
    
    local function getTargetPos()
        if not murderer or not murderer.Character then return nil end
        local hum = murderer.Character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return nil end
        local tp = murderer.Character:FindFirstChild(Config.TargetPart) or murderer.Character:FindFirstChild("HumanoidRootPart")
        if not tp then return nil end
        return getPredictedPosition(tp)
    end
    
    local initialPos = getTargetPos()
    if not initialPos then isFlicking = false return end
    local remote = hasGun and findShootRemote(false) or nil
    if hasGun and not remote then print("[CORE] No Shoot remote") isFlicking = false return end

    if not Config.VisualFlick then
        if not hasGun then isFlicking = false return end
        local muzzlePos, muzzleSource = getMuzzlePosition(initialPos)
        if not muzzlePos then isFlicking = false return end
        local freshTarget = getTargetPos() or initialPos
        freshTarget = adjustTargetForEnvironment(muzzlePos, freshTarget, murderer.Character)
        freshTarget = applySelfVelocityComp(freshTarget)
        local muzzleFinal = getMuzzlePosition(freshTarget) or muzzlePos
        local A_1 = CFrame.lookAt(muzzleFinal, freshTarget)
        local A_2 = CFrame.new(freshTarget)
        if Config.AutoShoot then pcall(function() remote:FireServer(A_1, A_2) end) end
        isFlicking = false
        return
    end

    if not sensitivityMeasured then calibrateSensitivity() end
    local accumX, accumY, lockedTarget, converged = aimLoop(getTargetPos)
    if not converged or not lockedTarget then smoothReturn(accumX, accumY) isFlicking = false return end
    local freshTarget = getTargetPos() or lockedTarget
    freshTarget = adjustTargetForEnvironment(cam.CFrame.Position, freshTarget, murderer.Character)
    freshTarget = applySelfVelocityComp(freshTarget)
    local snapYaw, snapPitch = getAngularDelta(cam, freshTarget)
    local snapAngleDeg = math.deg(math.sqrt(snapYaw * snapYaw + snapPitch * snapPitch))
    if snapAngleDeg > 0.05 and snapAngleDeg < Config.FinalSnapAngle then
        local pxPerRad = (sensitivityPxPerRad > 0) and sensitivityPxPerRad or 400
        local sdx = snapYaw * pxPerRad
        local sdy = -snapPitch * pxPerRad
        mousemoverel(sdx, sdy)
        accumX = accumX + sdx
        accumY = accumY + sdy
        RunService.RenderStepped:Wait()
    end
    if hasGun and remote then
        local muzzlePos = getMuzzlePosition(freshTarget)
        if not muzzlePos then muzzlePos = cam.CFrame.Position end
        local A_1 = CFrame.lookAt(muzzlePos, freshTarget)
        local A_2 = CFrame.new(freshTarget)
        if Config.AutoShoot then pcall(function() remote:FireServer(A_1, A_2) end) end
        scheduleUnequip()
    end
    smoothReturn(accumX, accumY)
    isFlicking = false
end

function testFire()
    local murderer = cachedMurderer or findMurderer()
    if not murderer or not murderer.Character then print("[CORE] TEST: No murderer") return end
    local char = LocalPlayer.Character
    if not char then return end
    if not forceEquipGun() then print("[CORE] TEST: cannot equip gun") return end
    task.wait(0.05)
    local remote = findShootRemote(false)
    if not remote then print("[CORE] TEST: No remote") return end
    local tp = murderer.Character:FindFirstChild("HumanoidRootPart")
    if not tp then return end
    local targetPos = getPredictedPosition(tp)
    local muzzlePos, muzzleSource = getMuzzlePosition(targetPos)
    if not muzzlePos then print("[CORE] TEST: no muzzle") return end
    local A_1 = CFrame.lookAt(muzzlePos, targetPos)
    local A_2 = CFrame.new(targetPos)
    print(string.format("[CORE] TEST FIRE: origin=(%.1f,%.1f,%.1f) from=%s", muzzlePos.X, muzzlePos.Y, muzzlePos.Z, muzzleSource))
    pcall(function() remote:FireServer(A_1, A_2) end)
    scheduleUnequip()
end

